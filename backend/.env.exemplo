# Copie este arquivo para `.env` e ajuste os valores para o seu ambiente.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Conexão com o banco de dados (formato SQLAlchemy)
UrlBancoDados=postgresql+psycopg://postgres:postgres@localhost:5432/pontoeixo

# Mostra no console todo SQL executado (true/false)
ExibirSqlNoConsole=false
