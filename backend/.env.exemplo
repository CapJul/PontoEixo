# Copie este arquivo para `.env` e ajuste os valores para o seu ambiente.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Conexão com o banco de dados (formato SQLAlchemy)
UrlBancoDados=postgresql+psycopg://postgres:postgres@localhost:5432/pontoeixo

# Mostra no console todo SQL executado (true/false)
ExibirSqlNoConsole=false

# Chave de assinatura dos tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
ChaveSecretaJwt=chave-de-desenvolvimento-pontoeixo-troque-em-producao
AlgoritmoJwt=HS256
# Validade do token de acesso, em minutos
MinutosExpiracaoTokenAcesso=60

# Recuperação de senha
MinutosExpiracaoCodigoRecuperacao=10
MaximoTentativasCodigoRecuperacao=5
SegundosEntreEnviosCodigo=60
MinutosExpiracaoTokenRedefinicao=15

# Envio de e-mails (SMTP). Deixe SmtpServidor vazio em desenvolvimento:
# o código de recuperação será exibido no console em vez de enviado.
# Exemplo Gmail: SmtpServidor=smtp.gmail.com / SmtpPorta=587 / SmtpSenha=<senha de app>
SmtpServidor=
SmtpPorta=587
SmtpUsuario=
SmtpSenha=
SmtpRemetente=PontoEixo <nao-responda@pontoeixo.com.br>
SmtpUsarStartTls=true
