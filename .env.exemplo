# Opcional: copie para `.env` (na raiz) para trocar os valores padrão do docker-compose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(64))"
CHAVE_SECRETA_JWT=troque-esta-chave-em-producao-pontoeixo

# Preencha para enviar o código de recuperação de senha por e-mail de verdade
SMTP_SERVIDOR=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
